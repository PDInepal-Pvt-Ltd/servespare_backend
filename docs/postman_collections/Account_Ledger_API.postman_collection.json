{
  "info": {
    "name": "Account Ledger API",
    "description": "Complete API collection for Account Ledger endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "YOUR_AUTH_TOKEN_HERE",
      "type": "string"
    },
    {
      "key": "shift_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "List Account Ledger",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/cash-and-bank/account-ledger/",
          "host": ["{{base_url}}"],
          "path": ["api", "cash-and-bank", "account-ledger", ""]
        }
      }
    },
    {
      "name": "List with Filters (Date Range)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/cash-and-bank/account-ledger/?from_date=2025-12-24&to_date=2025-12-24",
          "host": ["{{base_url}}"],
          "path": ["api", "cash-and-bank", "account-ledger", ""],
          "query": [
            {
              "key": "from_date",
              "value": "2025-12-24"
            },
            {
              "key": "to_date",
              "value": "2025-12-24"
            }
          ]
        }
      }
    },
    {
      "name": "List with Shift Filter",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/cash-and-bank/account-ledger/?shift_id={{shift_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "cash-and-bank", "account-ledger", ""],
          "query": [
            {
              "key": "shift_id",
              "value": "{{shift_id}}"
            }
          ]
        }
      }
    },
    {
      "name": "Get Ledger Entry Details",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/cash-and-bank/account-ledger/1/",
          "host": ["{{base_url}}"],
          "path": ["api", "cash-and-bank", "account-ledger", "1", ""]
        }
      }
    },
    {
      "name": "Get Ledger Summary",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/cash-and-bank/account-ledger/summary/?shift_id={{shift_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "cash-and-bank", "account-ledger", "summary", ""],
          "query": [
            {
              "key": "shift_id",
              "value": "{{shift_id}}"
            }
          ]
        }
      }
    },
    {
      "name": "Get General Ledger",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/cash-and-bank/account-ledger/general/",
          "host": ["{{base_url}}"],
          "path": ["api", "cash-and-bank", "account-ledger", "general", ""]
        }
      }
    },
    {
      "name": "Get Sales Ledger",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/cash-and-bank/account-ledger/sales/",
          "host": ["{{base_url}}"],
          "path": ["api", "cash-and-bank", "account-ledger", "sales", ""]
        }
      }
    },
    {
      "name": "Get Purchase Ledger",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/cash-and-bank/account-ledger/purchase/",
          "host": ["{{base_url}}"],
          "path": ["api", "cash-and-bank", "account-ledger", "purchase", ""]
        }
      }
    },
    {
      "name": "Get Ledger by Shift",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/cash-and-bank/account-ledger/by_shift/?shift_id={{shift_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "cash-and-bank", "account-ledger", "by_shift", ""],
          "query": [
            {
              "key": "shift_id",
              "value": "{{shift_id}}"
            }
          ]
        }
      }
    },
    {
      "name": "Create Manual Ledger Entry",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ledger_type\": \"general\",\n  \"transaction_type\": \"adjustment\",\n  \"debit\": 50.00,\n  \"credit\": 0.00,\n  \"description\": \"Manual adjustment for damaged goods\",\n  \"reference\": \"ADJ-001\",\n  \"reference_type\": \"adjustment\",\n  \"shift_id\": {{shift_id}},\n  \"notes\": \"Product damaged during shift\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/cash-and-bank/account-ledger/create_entry/",
          "host": ["{{base_url}}"],
          "path": ["api", "cash-and-bank", "account-ledger", "create_entry", ""]
        }
      }
    },
    {
      "name": "Print Ledger (Export)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/cash-and-bank/account-ledger/print_ledger/?shift_id={{shift_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "cash-and-bank", "account-ledger", "print_ledger", ""],
          "query": [
            {
              "key": "shift_id",
              "value": "{{shift_id}}"
            }
          ]
        }
      }
    },
    {
      "name": "Search Ledger Entries",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/cash-and-bank/account-ledger/?search=opening",
          "host": ["{{base_url}}"],
          "path": ["api", "cash-and-bank", "account-ledger", ""],
          "query": [
            {
              "key": "search",
              "value": "opening"
            }
          ]
        }
      }
    },
    {
      "name": "Filter by Transaction Type",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/cash-and-bank/account-ledger/?transaction_type=sale",
          "host": ["{{base_url}}"],
          "path": ["api", "cash-and-bank", "account-ledger", ""],
          "query": [
            {
              "key": "transaction_type",
              "value": "sale"
            }
          ]
        }
      }
    },
    {
      "name": "Filter by User",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/cash-and-bank/account-ledger/?performed_by_id=5",
          "host": ["{{base_url}}"],
          "path": ["api", "cash-and-bank", "account-ledger", ""],
          "query": [
            {
              "key": "performed_by_id",
              "value": "5"
            }
          ]
        }
      }
    },
    {
      "name": "Combined Filters (Date + Type + Branch)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/cash-and-bank/account-ledger/?from_date=2025-12-01&to_date=2025-12-31&ledger_type=general&branch_id=1",
          "host": ["{{base_url}}"],
          "path": ["api", "cash-and-bank", "account-ledger", ""],
          "query": [
            {
              "key": "from_date",
              "value": "2025-12-01"
            },
            {
              "key": "to_date",
              "value": "2025-12-31"
            },
            {
              "key": "ledger_type",
              "value": "general"
            },
            {
              "key": "branch_id",
              "value": "1"
            }
          ]
        }
      }
    }
  ]
}
